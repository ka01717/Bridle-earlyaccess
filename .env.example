# Bridle Environment Variables

# Canonical site URL (used in sitemap, robots, and Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://bridle.ai

# Company contact email (displayed in footer and used as official contact)
NEXT_PUBLIC_CONTACT_EMAIL=k.bridleteam@gmail.com

# Early Access recipient notification email (where access requests are sent)
NOTIFICATION_EMAIL=k.bridleteam@gmail.com

# Early Access endpoint (defaults to internal /api/early-access)
NEXT_PUBLIC_EARLY_ACCESS_ENDPOINT=/api/early-access

# Optional: Transactional Email API Key (e.g. Resend)
RESEND_API_KEY=

# Optional: Webhook URL (e.g. Zapier, Slack, Make)
EARLY_ACCESS_WEBHOOK_URL=
